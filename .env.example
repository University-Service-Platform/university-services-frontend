# Copy to .env (or .env.local) and adjust per environment. Only VITE_* variables reach the browser.

# API Gateway base path used by every service client (shared).
# Local integrated stack behind the same origin: /api/v1
# Separate gateway host:                         https://gateway.example.edu/api/v1
VITE_API_BASE_URL=/api/v1

# Group 8: synthetic demo data when Group 8 gateway routes are unreachable.
# Set to false in integrated/deployed environments so outages are visible.
VITE_G8_DEMO_MODE=true
