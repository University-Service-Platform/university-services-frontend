# Copy to .env (or .env.local) and adjust per environment. Only VITE_* variables reach the browser.

# API Gateway base path used by Group 7 service clients (shared).
# Local integrated stack behind the same origin: /api/v1
# Separate gateway host:                         https://gateway.example.edu/api/v1
VITE_API_BASE_URL=/api/v1

# Group 7 Microservice Development Backend Ports (Configured in vite.config.ts Proxy)
# Service Request Microservice -> http://localhost:8081
# Work Order Microservice       -> http://localhost:8082
